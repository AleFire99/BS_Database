  "ddl": {
    "card_colors": "CREATE TABLE card_colors (\n\tcard_id INTEGER NOT NULL, \n\tcolor_id INTEGER NOT NULL, \n\tPRIMARY KEY (card_id, color_id), \n\tFOREIGN KEY(card_id) REFERENCES cards (id), \n\tFOREIGN KEY(color_id) REFERENCES colors (id)\n)",
    "card_families": "CREATE TABLE card_families (\n\tcard_id INTEGER NOT NULL, \n\tfamily_id INTEGER NOT NULL, \n\tPRIMARY KEY (card_id, family_id), \n\tFOREIGN KEY(card_id) REFERENCES cards (id), \n\tFOREIGN KEY(family_id) REFERENCES families (id)\n)",
    "card_types": "CREATE TABLE card_types (\n\tid INTEGER NOT NULL, \n\tname VARCHAR, \n\tPRIMARY KEY (id), \n\tUNIQUE (name)\n)",
    "cards": "CREATE TABLE cards (\n\tid INTEGER NOT NULL, \n\tname VARCHAR, \n\tcard_id VARCHAR, \n\tcost INTEGER, \n\tsymbol VARCHAR, \n\timage VARCHAR, \n\ttype_id INTEGER, \n\tPRIMARY KEY (id), \n\tUNIQUE (card_id), \n\tFOREIGN KEY(type_id) REFERENCES card_types (id)\n)",
    "colors": "CREATE TABLE colors (\n\tid INTEGER NOT NULL, \n\tname VARCHAR, \n\tPRIMARY KEY (id), \n\tUNIQUE (name)\n)",
    "core_requirements": "CREATE TABLE core_requirements (\n\tid INTEGER NOT NULL, \n\tlevel INTEGER, \n\t\"battlePoints\" INTEGER, \n\tcores INTEGER, \n\tcard_id INTEGER, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(card_id) REFERENCES cards (id)\n)",
    "families": "CREATE TABLE families (\n\tid INTEGER NOT NULL, \n\tname VARCHAR, \n\tPRIMARY KEY (id), \n\tUNIQUE (name)\n)"
  },
